# 强制脚本与代码文件使用 LF 行尾（防止 Windows 提交时转成 CRLF，
# 导致 Linux/云主机上 bash 执行 deploy.sh 报 $'\r' 错误）
*.sh        text eol=lf
*.py        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.txt       text eol=lf
*.md        text eol=lf

# 文本文件默认按仓库存储内容提供（不在 checkout 时转换）
*            text=auto
