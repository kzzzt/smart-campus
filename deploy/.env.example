# 智慧校园管理平台 · 生产环境变量示例
# 拷贝为 deploy/.env 并修改实际值（.env 已被 .gitignore 排除，不会提交到仓库）
# deploy.sh 会把本文件作为 systemd EnvironmentFile 使用

# 会话加密密钥（务必设置为随机长字符串！可用 openssl rand -hex 32 生成）
SECRET_KEY=please-change-me-to-a-random-hex-string

# ========== 可选：接入真实大模型（不配置则自动降级为本地规则引擎） ==========
# LLM_API_KEY=sk-xxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ========== 可选：默认管理员口令覆盖（部署后可改，重启生效） ==========
# ADMIN_PASSWORD=your-strong-password

# 时区
TZ=Asia/Shanghai
